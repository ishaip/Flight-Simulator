# Environment configuration
# Copy this file to .env and adjust values as needed.
# The application reads these from the environment directly — no .env loading library is used.
# Run: export $(cat .env | xargs) && make run   (Linux/macOS)
#      Get-Content .env | ForEach-Object { $k,$v=$_.Split('=',2); [System.Environment]::SetEnvironmentVariable($k,$v) }  (PowerShell)

# Address the HTTP server listens on.
# Default: :8080
ADDR=:8080

# Directory to serve frontend static files from.
# Default: ../frontend  (relative to backend/ working directory)
# In Docker this is set to ./frontend automatically.
STATIC_DIR=../frontend
